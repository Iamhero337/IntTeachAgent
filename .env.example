# Required — Anthropic Claude (assessment + extraction + plan generation)
# Get one at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Optional — Google Gemini (only needed for voice/audio transcription)
# Without this, the mic button is disabled but the rest of the app works.
# Free key from https://aistudio.google.com
GEMINI_API_KEY=
